# Copy this file to .env and fill in your values. .env is gitignored.
# List your identities: security find-identity -v -p codesigning

# Dev builds — an "Apple Development: …" identity for a stable signature
# (so macOS keeps the Accessibility grant across rebuilds). Optional.
CODESIGN_IDENTITY="Apple Development: Your Name (TEAMID)"

# Notarized releases (see notarize.sh and README "Releasing"). Optional.
RELEASE_IDENTITY="Developer ID Application: Your Org (TEAMID)"
NOTARY_PROFILE="factorfill-notary"
